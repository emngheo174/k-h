# Copy the relevant values into .env.local (git-ignored) for local dev, and set
# the same variables in the Vercel project settings for production.

# Public site URL (used for absolute OG/canonical links).
NEXT_PUBLIC_SITE_URL=https://www.kienhanhwedding.io.vn

# --- Supabase (server-only, never prefix with NEXT_PUBLIC) ---
# Dashboard → Project Settings → API
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# The service_role key (NOT the anon key). Bypasses RLS; keep it secret.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Admin page (/admin) ---
# Any strong password; used to view RSVPs and wishes.
ADMIN_PASSWORD=choose-a-strong-password
